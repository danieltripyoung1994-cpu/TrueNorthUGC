# ============================================================
# Clerk Authentication
# Get these from https://dashboard.clerk.com -> your app -> API Keys
# ============================================================

# Frontend (Vite exposes vars prefixed with VITE_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend (server-side only, never exposed to the browser)
CLERK_SECRET_KEY=sk_test_...

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================================
# Optional: session encryption (legacy, not needed with Clerk)
# ============================================================
# SESSION_SECRET=random-string
