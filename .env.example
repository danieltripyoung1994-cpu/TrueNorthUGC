# ==============================================================================
# TrueNorthUGC Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/truenorthugc

# --- Session ---
SESSION_SECRET=your-session-secret-here

# --- Authentication (Clerk) ---
# Get these from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- AI / OpenAI ---
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxx
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Gmail (Google OAuth2) ---
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-google-refresh-token
GMAIL_SENDER_EMAIL=noreply@truenorthugc.com

# --- PayPal ---
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# --- Google Cloud Storage ---
# Choose ONE authentication method:
#   1) GCS_KEYFILE_PATH: path to a service account JSON key file
#   2) GCS_CREDENTIALS_JSON: inline JSON key string
#   3) GOOGLE_APPLICATION_CREDENTIALS: standard GCP env var
GCS_PROJECT_ID=your-gcp-project-id
# GCS_KEYFILE_PATH=/path/to/service-account-key.json
# GCS_CREDENTIALS_JSON={"type":"service_account",...}

# --- Object Storage Paths ---
PUBLIC_OBJECT_SEARCH_PATHS=/bucket-name/public
PRIVATE_OBJECT_DIR=/bucket-name/private

# --- Optional ---
NODE_ENV=development
PG_POOL_MAX=10
PG_IDLE_TIMEOUT=30000
